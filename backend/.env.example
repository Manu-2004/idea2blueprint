# Required: OpenAI API key used by all agents.
OPENAI_API_KEY=

# Optional: default model for all agents (falls back to this if a per-agent override isn't set).
OPENAI_MODEL_DEFAULT=gpt-4.1-mini

# Optional: per-agent model overrides. The reviewer defaults to a stronger model since it's
# the one node doing genuine cross-checking between the other three agents' output.
OPENAI_MODEL_PRODUCT=
OPENAI_MODEL_UX=
OPENAI_MODEL_TECHNICAL=
OPENAI_MODEL_REVIEWER=gpt-4.1

# Optional: how many extra revision rounds the reviewer can request before the graph forces
# assembly regardless of verdict.
MAX_REVISION_ROUNDS=2

# Optional: comma-separated origins allowed to call the API directly from a browser (only
# used by `blueprint_agents.api`, not the CLI).
CORS_ORIGINS=http://localhost:3000

# Optional: sqlite file holding users/sessions/spec_jobs (only used by `blueprint_agents.api`).
DATABASE_PATH=blueprint_agents.db
